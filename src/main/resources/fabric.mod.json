{
  "schemaVersion": 1,
  "id": "aoptools",
  "version": "${version}",
  "name": "AOP Tools",
  "description": "A searchable preset-based Meteor Client workflow editor for authorized server administration and player pranks.",
  "authors": [
    "pelyh"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "hu.pelyh.aoptools.AopToolsAddon"
    ]
  },
  "custom": {
    "meteor-client:color": "40,160,255",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "meteor-client": "*"
  },
  "suggests": {
    "sodium": "*",
    "entityculling": "*",
    "ferritecore": "*",
    "lithium": "*",
    "immediatelyfast": "*",
    "krypton": "*",
    "clumps": "*",
    "fastipping": "*",
    "fastquit": "*",
    "spark": "*"
  }
}
